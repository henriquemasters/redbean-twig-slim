{% extends 'template.twig' %}

{% block content %}
    <main class="showcase-shell slim-page">
        <section class="feature-page reveal">
            <span class="eyebrow">Recurso demonstrado</span>
            <h1>Area administrativa com autenticacao e ACL por rota.</h1>
            <p>O grupo <code>/admin</code> combina middleware de sessao e ACL. As permissoes sao lidas do banco e aplicadas tambem nas views com o helper Twig <code>isAllow()</code>.</p>
            <div class="code-card">/admin/* -> session middleware -> ACL middleware -> controller</div>
            <a class="btn-showcase btn-primary-showcase" href="{{ base_url('') }}/login">Abrir login</a>
        </section>
    </main>
{% endblock %}
