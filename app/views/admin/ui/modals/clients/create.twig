<form id="formModal" name="formModal" method="post" action="{{ base_url() }}/admin/clients/save" class="form-horizontal" autocomplete="off">
    {{ csrf_field() }}
    <input name="_type" type="hidden" value="client">
    <input name="id" type="hidden" value="{{ client.id }}">

    <div class="modal-body small">
        <div class="form-group">
            <label>Nome do cliente</label>
            <input type="text" name="name" value="{{ client.name }}" class="form-control" required placeholder="Ex.: Cliente piloto">
        </div>
        <div class="form-row">
            <div class="form-group col-md-7">
                <label>E-mail</label>
                <input type="email" name="email" value="{{ client.email }}" class="form-control" required placeholder="contato@cliente.com">
            </div>
            <div class="form-group col-md-5">
                <label>Telefone</label>
                <input type="text" name="phone" value="{{ client.phone }}" class="form-control" placeholder="(00) 00000-0000">
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-6">
                <label>Status</label>
                <select name="status" class="form-control" required>
                    <option value="">-- Selecione --</option>
                    {% for value, label in statuses %}
                        <option value="{{ value }}" {{ (value == client.status) ? 'selected' : '' }}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="form-group col-md-6">
                <label>Segmento</label>
                <input type="text" name="segment" value="{{ client.segment }}" class="form-control" placeholder="Ex.: Saúde, varejo, serviços">
            </div>
        </div>
        <div class="form-group">
            <label>Observações</label>
            <textarea name="notes" rows="4" class="form-control" placeholder="Descreva contexto, dores e oportunidade para MVP/POC">{{ client.notes }}</textarea>
        </div>
    </div>

    <div class="modal-footer justify-content-between">
        <button class="btn btn-sm btn-primary"><i class="fa fa-check-circle"></i> <span class="small">CONFIRMAR</span></button>
        <a href="javascript:;" class="btn btn-sm btn-default" data-dismiss="modal"><i class="fa fa-times-circle"></i> <span class="small">CANCELAR</span></a>
    </div>
</form>
