{% extends 'template.twig' %}

{% block content %}
    <main class="showcase-shell slim-page">
        <section class="feature-page reveal">
            <span class="eyebrow">Recurso demonstrado</span>
            <h1>Roteamento direto com Slim e renderizacao Twig.</h1>
            <p>Em <code>app/routes.php</code>, cada endpoint aponta para uma action de controller. A action recebe objetos PSR-7, prepara dados minimos e entrega a interface para Twig.</p>
            <div class="code-card">GET /page-1 -> SiteController:PageOne -> pages/page-1.twig</div>
            <a class="text-link" href="{{ base_url('') }}">Voltar para a vitrine</a>
        </section>
    </main>
{% endblock %}
